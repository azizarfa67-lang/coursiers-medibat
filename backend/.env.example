# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coursier_tracking
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_another_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin (pour les notifications push FCM)
# Chemin vers le fichier de clé de service Firebase (JSON), téléchargé depuis
# Firebase Console > Paramètres du projet > Comptes de service
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# CORS - domaines autorisés (dashboard admin, etc.), séparés par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
